.version 8.0
.target sm_86
.address_size 64
.visible .entry unpack(.param .u64 input, .param .u64 output, .param .u32 n)
{
.reg .pred %p<3>;
.reg .b32 %r<64>;
.reg .b64 %rd<8>;
ld.param.u64 %rd1, [input];
ld.param.u64 %rd2, [output];
ld.param.u32 %r1, [n];
mov.u32 %r2, %ctaid.x;
mov.u32 %r3, %ntid.x;
mov.u32 %r4, %tid.x;
mad.lo.u32 %r5, %r2, %r3, %r4;
setp.ge.u32 %p1, %r5, %r1;
@%p1 bra DONE;
shr.u32 %r10, %r5, 3;
and.b32 %r11, %r5, 7;
shl.b32 %r11, %r11, 2;
mul.wide.u32 %rd3, %r10, 4;
mul.wide.u32 %rd4, %r5, 4;
add.u64 %rd5, %rd1, %rd3;
add.u64 %rd6, %rd2, %rd4;
ld.global.u32 %r6, [%rd5];
shr.u32 %r7, %r6, %r11;
and.b32 %r7, %r7, 15;
shl.b32 %r8, %r7, 14;
or.b32 %r7, %r7, %r8;
and.b32 %r7, %r7, 196611;
shl.b32 %r8, %r7, 7;
or.b32 %r7, %r7, %r8;
and.b32 %r7, %r7, 16843009;
st.global.u32 [%rd6], %r7;
DONE:
ret;
}
