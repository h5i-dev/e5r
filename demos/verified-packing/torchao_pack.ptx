.version 8.0
.target sm_86
.address_size 64
.visible .entry torchao_pack(.param .u64 low, .param .u64 high, .param .u64 output, .param .u32 n)
{
.reg .pred %p<2>;
.reg .b32 %r<10>;
.reg .b64 %rd<9>;
ld.param.u64 %rd1, [low];
ld.param.u64 %rd2, [high];
ld.param.u64 %rd3, [output];
ld.param.u32 %r1, [n];
mov.u32 %r2, %ctaid.x;
mov.u32 %r3, %ntid.x;
mov.u32 %r4, %tid.x;
mad.lo.u32 %r5, %r2, %r3, %r4;
setp.ge.u32 %p1, %r5, %r1;
@%p1 bra DONE;
mul.wide.u32 %rd4, %r5, 4;
add.u64 %rd5, %rd1, %rd4;
add.u64 %rd6, %rd2, %rd4;
add.u64 %rd7, %rd3, %rd4;
ld.global.u32 %r6, [%rd5];
ld.global.u32 %r7, [%rd6];
and.b32 %r6, %r6, 252645135;
and.b32 %r7, %r7, 252645135;
shl.b32 %r7, %r7, 4;
or.b32 %r8, %r6, %r7;
st.global.u32 [%rd7], %r8;
DONE:
ret;
}
