// Agent-authored direct PTX, 17-tap uint32 stencil, four outputs/thread.
.version 9.2
.target sm_86
.address_size 64
.visible .entry stencil17(
 .param .u64 stencil17_param_0,
 .param .u64 stencil17_param_1,
 .param .u32 stencil17_param_2
) {
.reg .pred %p<8>;
.reg .b32 %r<90>;
.reg .b64 %rd<30>;
.shared .align 8 .b8 stage[8192];
ld.param.u64 %rd1, [stencil17_param_0];
ld.param.u64 %rd2, [stencil17_param_1];
ld.param.u32 %r2, [stencil17_param_2];
mov.u32 %r3, %ntid.x;
mov.u32 %r4, %ctaid.x;
mov.u32 %r5, %tid.x;
mad.lo.u32 %r1, %r4, %r3, %r5;
add.u32 %r6, %r2, 3;
shr.u32 %r6, %r6, 2;
setp.ge.u32 %p1, %r1, %r6;
@%p1 bra BARRIER;
shl.b32 %r1, %r1, 2;
mul.wide.u32 %rd5, %r1, 4;
add.u64 %rd6, %rd1, %rd5;
add.u64 %rd7, %rd2, %rd5;
mov.u32 %r70, stage;
shl.b32 %r71, %r5, 4;
add.u32 %r70, %r70, %r71;
ld.global.u32 %r10, [%rd6+0];
ld.global.u32 %r11, [%rd6+4];
ld.global.u32 %r12, [%rd6+8];
ld.global.u32 %r13, [%rd6+12];
ld.global.u32 %r14, [%rd6+16];
ld.global.u32 %r15, [%rd6+20];
ld.global.u32 %r16, [%rd6+24];
ld.global.u32 %r17, [%rd6+28];
ld.global.u32 %r18, [%rd6+32];
ld.global.u32 %r19, [%rd6+36];
ld.global.u32 %r20, [%rd6+40];
ld.global.u32 %r21, [%rd6+44];
ld.global.u32 %r22, [%rd6+48];
ld.global.u32 %r23, [%rd6+52];
ld.global.u32 %r24, [%rd6+56];
ld.global.u32 %r25, [%rd6+60];
ld.global.u32 %r26, [%rd6+64];
mov.u32 %r40, %r10;
add.u32 %r40, %r40, %r11;
add.u32 %r40, %r40, %r12;
add.u32 %r40, %r40, %r13;
add.u32 %r40, %r40, %r14;
add.u32 %r40, %r40, %r15;
add.u32 %r40, %r40, %r16;
add.u32 %r40, %r40, %r17;
add.u32 %r40, %r40, %r18;
add.u32 %r40, %r40, %r19;
add.u32 %r40, %r40, %r20;
add.u32 %r40, %r40, %r21;
add.u32 %r40, %r40, %r22;
add.u32 %r40, %r40, %r23;
add.u32 %r40, %r40, %r24;
add.u32 %r40, %r40, %r25;
add.u32 %r40, %r40, %r26;
st.shared.u32 [%r70], %r40;
add.u32 %r7, %r1, 1;
setp.ge.u32 %p1, %r7, %r2;
@%p1 bra BARRIER;
ld.global.u32 %r50, [%rd6+68];
sub.u32 %r40, %r40, %r10;
add.u32 %r40, %r40, %r50;
st.shared.u32 [%r70+4], %r40;
add.u32 %r7, %r1, 2;
setp.ge.u32 %p1, %r7, %r2;
@%p1 bra BARRIER;
ld.global.u32 %r50, [%rd6+72];
sub.u32 %r40, %r40, %r11;
add.u32 %r40, %r40, %r50;
st.shared.u32 [%r70+8], %r40;
add.u32 %r7, %r1, 3;
setp.ge.u32 %p1, %r7, %r2;
@%p1 bra BARRIER;
ld.global.u32 %r50, [%rd6+76];
sub.u32 %r40, %r40, %r12;
add.u32 %r40, %r40, %r50;
st.shared.u32 [%r70+12], %r40;
BARRIER:
bar.sync 0;
// 64-bit arithmetic also handles inactive oversized launches without wrap.
mul.wide.u32 %rd10, %r4, %r3;
shl.b64 %rd10, %rd10, 2;
cvt.u64.u32 %rd11, %r5;
add.u64 %rd10, %rd10, %rd11;
cvt.u64.u32 %rd12, %r2;
cvt.u64.u32 %rd13, %r3;
mov.u32 %r70, stage;
mov.u32 %r71, %r5;
setp.ge.u64 %p1, %rd10, %rd12;
@%p1 bra DONE;
shl.b32 %r72, %r71, 2;
add.u32 %r72, %r70, %r72;
ld.shared.u32 %r40, [%r72];
shl.b64 %rd14, %rd10, 2;
add.u64 %rd7, %rd2, %rd14;
st.global.u32 [%rd7], %r40;
add.u64 %rd10, %rd10, %rd13;
add.u32 %r71, %r71, %r3;
setp.ge.u64 %p1, %rd10, %rd12;
@%p1 bra DONE;
shl.b32 %r72, %r71, 2;
add.u32 %r72, %r70, %r72;
ld.shared.u32 %r40, [%r72];
shl.b64 %rd14, %rd10, 2;
add.u64 %rd7, %rd2, %rd14;
st.global.u32 [%rd7], %r40;
add.u64 %rd10, %rd10, %rd13;
add.u32 %r71, %r71, %r3;
setp.ge.u64 %p1, %rd10, %rd12;
@%p1 bra DONE;
shl.b32 %r72, %r71, 2;
add.u32 %r72, %r70, %r72;
ld.shared.u32 %r40, [%r72];
shl.b64 %rd14, %rd10, 2;
add.u64 %rd7, %rd2, %rd14;
st.global.u32 [%rd7], %r40;
add.u64 %rd10, %rd10, %rd13;
add.u32 %r71, %r71, %r3;
setp.ge.u64 %p1, %rd10, %rd12;
@%p1 bra DONE;
shl.b32 %r72, %r71, 2;
add.u32 %r72, %r70, %r72;
ld.shared.u32 %r40, [%r72];
shl.b64 %rd14, %rd10, 2;
add.u64 %rd7, %rd2, %rd14;
st.global.u32 [%rd7], %r40;
DONE:
ret;
}
