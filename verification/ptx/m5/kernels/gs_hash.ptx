.version 8.0
.target sm_86
.address_size 64

.visible .entry gs_hash(.param .u64 gs_hash_x, .param .u64 gs_hash_y, .param .u32 gs_hash_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<11>;
	.reg .b64 %rd<10>;
	ld.param.u64 %rd1, [gs_hash_x];
	ld.param.u64 %rd2, [gs_hash_y];
	ld.param.u32 %r1, [gs_hash_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mov.u32 %r5, %nctaid.x;
	mul.wide.u32 %rd3, %r2, %r3;
	cvt.u64.u32 %rd4, %r4;
	add.u64 %rd3, %rd3, %rd4;
	mul.wide.u32 %rd5, %r5, %r3;
	cvt.u64.u32 %rd6, %r1;
LOOP:
	setp.ge.u64 %p1, %rd3, %rd6;
	@%p1 bra DONE;
	shl.b64 %rd7, %rd3, 2;
	add.u64 %rd8, %rd1, %rd7;
	add.u64 %rd9, %rd2, %rd7;
	ld.global.u32 %r6, [%rd8];
	shr.u32 %r7, %r6, 16;
	xor.b32 %r8, %r6, %r7;
	mul.lo.u32 %r9, %r8, 73244475;
	st.global.u32 [%rd9], %r9;
	add.u64 %rd3, %rd3, %rd5;
	bra.uni LOOP;
DONE:
	ret;
}
