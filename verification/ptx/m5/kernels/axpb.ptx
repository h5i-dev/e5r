.version 8.0
.target sm_86
.address_size 64

.visible .entry axpb(.param .u64 axpb_x, .param .u64 axpb_y, .param .u32 axpb_a, .param .u32 axpb_b, .param .u32 axpb_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<10>;
	.reg .b64 %rd<8>;
	ld.param.u64 %rd1, [axpb_x];
	ld.param.u64 %rd2, [axpb_y];
	ld.param.u32 %r1, [axpb_a];
	ld.param.u32 %r2, [axpb_b];
	ld.param.u32 %r3, [axpb_n];
	mov.u32 %r4, %ctaid.x;
	mov.u32 %r5, %ntid.x;
	mov.u32 %r6, %tid.x;
	mad.lo.u32 %r7, %r4, %r5, %r6;
	setp.ge.u32 %p1, %r7, %r3;
	@%p1 ret;
	mul.wide.u32 %rd3, %r7, 4;
	add.u64 %rd4, %rd1, %rd3;
	add.u64 %rd5, %rd2, %rd3;
	ld.global.u32 %r8, [%rd4];
	mad.lo.u32 %r9, %r8, %r1, %r2;
	st.global.u32 [%rd5], %r9;
	ret;
}
