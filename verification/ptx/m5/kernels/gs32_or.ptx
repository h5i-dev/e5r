.version 8.0
.target sm_86
.address_size 64

.visible .entry gs32_or(.param .u64 gs32_or_a, .param .u64 gs32_or_b, .param .u64 gs32_or_c, .param .u32 gs32_or_n)
{
	.reg .pred %p<3>;
	.reg .b32 %r<12>;
	.reg .b64 %rd<10>;
	ld.param.u64 %rd1, [gs32_or_a];
	ld.param.u64 %rd2, [gs32_or_b];
	ld.param.u64 %rd3, [gs32_or_c];
	ld.param.u32 %r1, [gs32_or_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	mov.u32 %r6, %nctaid.x;
	mul.lo.u32 %r7, %r6, %r3;
TOP:
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd4, %r5, 4;
	add.u64 %rd5, %rd1, %rd4;
	add.u64 %rd6, %rd2, %rd4;
	add.u64 %rd7, %rd3, %rd4;
	ld.global.u32 %r8, [%rd5];
	ld.global.u32 %r9, [%rd6];
	or.b32 %r10, %r8, %r9;
	st.global.u32 [%rd7], %r10;
	add.u32 %r5, %r5, %r7;
	setp.lt.u32 %p2, %r5, %r1;
	@%p2 bra TOP;
DONE:
	ret;
}
