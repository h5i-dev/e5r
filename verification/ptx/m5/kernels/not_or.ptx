.version 8.0
.target sm_86
.address_size 64

.visible .entry not_or(.param .u64 not_or_a, .param .u64 not_or_b, .param .u64 not_or_c, .param .u32 not_or_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<24>;
	.reg .b64 %rd<24>;
	ld.param.u64 %rd1, [not_or_a];
	ld.param.u64 %rd2, [not_or_b];
	ld.param.u64 %rd3, [not_or_c];
	ld.param.u32 %r1, [not_or_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd10, %r5, 4;
	add.u64 %rd11, %rd1, %rd10;
	add.u64 %rd12, %rd2, %rd10;
	add.u64 %rd13, %rd3, %rd10;
	ld.global.u32 %r10, [%rd11];
	ld.global.u32 %r11, [%rd12];
	not.b32 %r9, %r10;
	or.b32 %r9, %r9, %r11;
	st.global.u32 [%rd13], %r9;
DONE:
	ret;
}
