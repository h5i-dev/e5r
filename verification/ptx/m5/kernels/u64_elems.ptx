.version 8.0
.target sm_86
.address_size 64

.visible .entry u64_elems(.param .u64 u64_elems_x, .param .u64 u64_elems_y, .param .u32 u64_elems_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<6>;
	.reg .b64 %rd<9>;
	ld.param.u64 %rd1, [u64_elems_x];
	ld.param.u64 %rd2, [u64_elems_y];
	ld.param.u32 %r1, [u64_elems_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd3, %r5, 8;
	add.u64 %rd4, %rd1, %rd3;
	add.u64 %rd5, %rd2, %rd3;
	ld.global.u64 %rd6, [%rd4];
	add.u64 %rd7, %rd6, 1;
	st.global.u64 [%rd5], %rd7;
DONE:
	ret;
}
