.version 8.0
.target sm_86
.address_size 64

.visible .entry pred_store(.param .u64 pred_store_x, .param .u64 pred_store_y, .param .u32 pred_store_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<8>;
	.reg .b64 %rd<6>;
	ld.param.u64 %rd1, [pred_store_x];
	ld.param.u64 %rd2, [pred_store_y];
	ld.param.u32 %r1, [pred_store_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.lt.u32 %p1, %r5, %r1;
	mul.wide.u32 %rd3, %r5, 4;
	add.u64 %rd4, %rd1, %rd3;
	add.u64 %rd5, %rd2, %rd3;
	@%p1 ld.global.u32 %r6, [%rd4];
	@%p1 not.b32 %r7, %r6;
	@%p1 st.global.u32 [%rd5], %r7;
	ret;
}
