.version 8.0
.target sm_86
.address_size 64

.visible .entry gs32_saxpy(.param .u64 gs32_saxpy_x, .param .u64 gs32_saxpy_y, .param .u32 gs32_saxpy_a, .param .u32 gs32_saxpy_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<12>;
	.reg .b64 %rd<6>;
	ld.param.u64 %rd1, [gs32_saxpy_x];
	ld.param.u64 %rd2, [gs32_saxpy_y];
	ld.param.u32 %r1, [gs32_saxpy_a];
	ld.param.u32 %r2, [gs32_saxpy_n];
	mov.u32 %r3, %ctaid.x;
	mov.u32 %r4, %ntid.x;
	mov.u32 %r5, %tid.x;
	mad.lo.u32 %r6, %r3, %r4, %r5;
	mov.u32 %r7, %nctaid.x;
	mul.lo.u32 %r8, %r7, %r4;
LOOP:
	setp.ge.u32 %p1, %r6, %r2;
	@%p1 bra DONE;
	mul.wide.u32 %rd3, %r6, 4;
	add.u64 %rd4, %rd1, %rd3;
	add.u64 %rd5, %rd2, %rd3;
	ld.global.u32 %r9, [%rd4];
	ld.global.u32 %r10, [%rd5];
	mad.lo.u32 %r11, %r1, %r9, %r10;
	st.global.u32 [%rd5], %r11;
	add.u32 %r6, %r6, %r8;
	bra.uni LOOP;
DONE:
	ret;
}
