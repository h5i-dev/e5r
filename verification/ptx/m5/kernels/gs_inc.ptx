.version 8.0
.target sm_86
.address_size 64

.visible .entry gs_inc(.param .u64 gs_inc_x, .param .u32 gs_inc_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<9>;
	.reg .b64 %rd<10>;
	ld.param.u64 %rd1, [gs_inc_x];
	ld.param.u32 %r1, [gs_inc_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mov.u32 %r5, %nctaid.x;
	mul.wide.u32 %rd2, %r2, %r3;
	cvt.u64.u32 %rd3, %r4;
	add.u64 %rd2, %rd2, %rd3;
	mul.wide.u32 %rd4, %r5, %r3;
	cvt.u64.u32 %rd5, %r1;
LOOP:
	setp.ge.u64 %p1, %rd2, %rd5;
	@%p1 bra DONE;
	shl.b64 %rd6, %rd2, 2;
	add.u64 %rd7, %rd1, %rd6;
	ld.global.u32 %r6, [%rd7];
	add.u32 %r7, %r6, 1;
	st.global.u32 [%rd7], %r7;
	add.u64 %rd2, %rd2, %rd4;
	bra.uni LOOP;
DONE:
	ret;
}
