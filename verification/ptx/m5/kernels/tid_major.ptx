.version 8.0
.target sm_86
.address_size 64

.visible .entry tid_major(.param .u64 tid_major_a, .param .u64 tid_major_b, .param .u64 tid_major_c, .param .u32 tid_major_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<10>;
	.reg .b64 %rd<8>;
	ld.param.u64 %rd1, [tid_major_a];
	ld.param.u64 %rd2, [tid_major_b];
	ld.param.u64 %rd3, [tid_major_c];
	ld.param.u32 %r1, [tid_major_n];
	mov.u32 %r2, %tid.x;
	mov.u32 %r3, %ctaid.x;
	mov.u32 %r4, %ntid.x;
	mad.lo.u32 %r5, %r4, %r3, %r2;
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd4, %r5, 4;
	add.u64 %rd5, %rd1, %rd4;
	add.u64 %rd6, %rd2, %rd4;
	add.u64 %rd7, %rd3, %rd4;
	ld.global.u32 %r6, [%rd5];
	ld.global.u32 %r7, [%rd6];
	shl.b32 %r8, %r7, 1;
	add.u32 %r9, %r6, %r8;
	st.global.u32 [%rd7], %r9;
DONE:
	ret;
}
