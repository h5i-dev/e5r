.version 8.0
.target sm_86
.address_size 64

.visible .entry saxpy_ip(.param .u64 saxpy_ip_x, .param .u64 saxpy_ip_y, .param .u32 saxpy_ip_a, .param .u32 saxpy_ip_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<10>;
	.reg .b64 %rd<6>;
	ld.param.u64 %rd1, [saxpy_ip_x];
	ld.param.u64 %rd2, [saxpy_ip_y];
	ld.param.u32 %r1, [saxpy_ip_a];
	ld.param.u32 %r2, [saxpy_ip_n];
	mov.u32 %r3, %ctaid.x;
	mov.u32 %r4, %ntid.x;
	mov.u32 %r5, %tid.x;
	mad.lo.s32 %r6, %r3, %r4, %r5;
	setp.ge.s32 %p1, %r6, %r2;
	@%p1 bra DONE;
	mul.wide.s32 %rd3, %r6, 4;
	add.s64 %rd4, %rd1, %rd3;
	add.s64 %rd5, %rd2, %rd3;
	ld.global.u32 %r7, [%rd4];
	ld.global.u32 %r8, [%rd5];
	mad.lo.s32 %r9, %r7, %r1, %r8;
	st.global.u32 [%rd5], %r9;
DONE:
	ret;
}
