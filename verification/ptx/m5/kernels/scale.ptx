.version 8.0
.target sm_86
.address_size 64

.visible .entry scale(.param .u64 scale_x, .param .u64 scale_y, .param .u32 scale_k, .param .u32 scale_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<9>;
	.reg .b64 %rd<8>;
	ld.param.u64 %rd1, [scale_x];
	ld.param.u64 %rd2, [scale_y];
	ld.param.u32 %r1, [scale_k];
	ld.param.u32 %r2, [scale_n];
	mov.u32 %r3, %ctaid.x;
	mov.u32 %r4, %ntid.x;
	mov.u32 %r5, %tid.x;
	mad.lo.u32 %r6, %r3, %r4, %r5;
	setp.ge.u32 %p1, %r6, %r2;
	@%p1 exit;
	mul.wide.u32 %rd3, %r6, 4;
	add.u64 %rd4, %rd1, %rd3;
	add.u64 %rd5, %rd2, %rd3;
	ld.global.u32 %r7, [%rd4];
	mul.lo.u32 %r8, %r7, %r1;
	st.global.u32 [%rd5], %r8;
	ret;
}
