.version 8.0
.target sm_86
.address_size 64

.visible .entry sel_guard(.param .u64 sel_guard_x, .param .u64 sel_guard_y, .param .u32 sel_guard_n)
{
	.reg .pred %p<3>;
	.reg .b32 %r<10>;
	.reg .b64 %rd<6>;
	ld.param.u64 %rd1, [sel_guard_x];
	ld.param.u64 %rd2, [sel_guard_y];
	ld.param.u32 %r1, [sel_guard_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.lt.u32 %p1, %r5, %r1;
	selp.u32 %r6, 1, 0, %p1;
	setp.eq.u32 %p2, %r6, 0;
	@%p2 bra DONE;
	mul.wide.u32 %rd3, %r5, 4;
	add.u64 %rd4, %rd1, %rd3;
	add.u64 %rd5, %rd2, %rd3;
	ld.global.u32 %r7, [%rd4];
	add.u32 %r8, %r7, -1;
	st.global.u32 [%rd5], %r8;
DONE:
	ret;
}
