.version 8.0
.target sm_86
.address_size 64

.visible .entry gs32_neg(.param .u64 gs32_neg_x, .param .u64 gs32_neg_y, .param .u32 gs32_neg_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<12>;
	.reg .b64 %rd<8>;
	ld.param.u64 %rd1, [gs32_neg_x];
	ld.param.u64 %rd2, [gs32_neg_y];
	ld.param.u32 %r1, [gs32_neg_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	mov.u32 %r6, %nctaid.x;
	mul.lo.u32 %r7, %r6, %r3;
LOOP:
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd3, %r5, 4;
	add.u64 %rd4, %rd1, %rd3;
	add.u64 %rd5, %rd2, %rd3;
	ld.global.u32 %r8, [%rd4];
	neg.s32 %r9, %r8;
	st.global.u32 [%rd5], %r9;
	add.u32 %r5, %r5, %r7;
	bra.uni LOOP;
DONE:
	ret;
}
