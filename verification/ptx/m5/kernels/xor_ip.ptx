.version 8.0
.target sm_86
.address_size 64

.visible .entry xor_ip(.param .u64 xor_ip_x, .param .u32 xor_ip_k, .param .u32 xor_ip_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<9>;
	.reg .b64 %rd<4>;
	ld.param.u64 %rd1, [xor_ip_x];
	ld.param.u32 %r1, [xor_ip_k];
	ld.param.u32 %r2, [xor_ip_n];
	mov.u32 %r3, %ctaid.x;
	mov.u32 %r4, %ntid.x;
	mov.u32 %r5, %tid.x;
	mad.lo.u32 %r6, %r3, %r4, %r5;
	setp.ge.u32 %p1, %r6, %r2;
	@%p1 bra DONE;
	mul.wide.u32 %rd2, %r6, 4;
	add.u64 %rd3, %rd1, %rd2;
	ld.global.u32 %r7, [%rd3];
	xor.b32 %r8, %r7, %r1;
	st.global.u32 [%rd3], %r8;
DONE:
	ret;
}
