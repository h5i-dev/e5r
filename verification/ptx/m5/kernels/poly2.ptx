.version 8.0
.target sm_86
.address_size 64

.visible .entry poly2(.param .u64 poly2_x, .param .u64 poly2_y, .param .u32 poly2_a, .param .u32 poly2_b, .param .u32 poly2_c, .param .u32 poly2_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<14>;
	.reg .b64 %rd<6>;
	ld.param.u64 %rd1, [poly2_x];
	ld.param.u64 %rd2, [poly2_y];
	ld.param.u32 %r1, [poly2_a];
	ld.param.u32 %r2, [poly2_b];
	ld.param.u32 %r3, [poly2_c];
	ld.param.u32 %r4, [poly2_n];
	mov.u32 %r5, %ctaid.x;
	mov.u32 %r6, %ntid.x;
	mov.u32 %r7, %tid.x;
	mad.lo.u32 %r8, %r5, %r6, %r7;
	setp.ge.u32 %p1, %r8, %r4;
	@%p1 bra DONE;
	mul.wide.u32 %rd3, %r8, 4;
	add.u64 %rd4, %rd1, %rd3;
	add.u64 %rd5, %rd2, %rd3;
	ld.global.u32 %r9, [%rd4];
	mad.lo.u32 %r10, %r1, %r9, %r2;
	mad.lo.u32 %r11, %r10, %r9, %r3;
	st.global.u32 [%rd5], %r11;
DONE:
	ret;
}
