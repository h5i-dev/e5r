.version 8.0
.target sm_86
.address_size 64

.visible .entry mulwide_idx(.param .u64 mulwide_idx_x, .param .u64 mulwide_idx_y, .param .u32 mulwide_idx_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<8>;
	.reg .b64 %rd<10>;
	ld.param.u64 %rd1, [mulwide_idx_x];
	ld.param.u64 %rd2, [mulwide_idx_y];
	ld.param.u32 %r1, [mulwide_idx_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mul.wide.u32 %rd3, %r2, %r3;
	cvt.u64.u32 %rd4, %r4;
	add.u64 %rd5, %rd3, %rd4;
	cvt.u64.u32 %rd6, %r1;
	setp.ge.u64 %p1, %rd5, %rd6;
	@%p1 bra DONE;
	shl.b64 %rd7, %rd5, 2;
	add.u64 %rd8, %rd1, %rd7;
	add.u64 %rd9, %rd2, %rd7;
	ld.global.u32 %r5, [%rd8];
	xor.b32 %r6, %r5, 1431655765;
	st.global.u32 [%rd9], %r6;
DONE:
	ret;
}
