.version 8.0
.target sm_86
.address_size 64

.visible .entry msub(.param .u64 msub_a, .param .u64 msub_b, .param .u64 msub_c, .param .u64 msub_d, .param .u32 msub_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<11>;
	.reg .b64 %rd<10>;
	ld.param.u64 %rd1, [msub_a];
	ld.param.u64 %rd2, [msub_b];
	ld.param.u64 %rd3, [msub_c];
	ld.param.u64 %rd4, [msub_d];
	ld.param.u32 %r1, [msub_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd5, %r5, 4;
	add.u64 %rd6, %rd1, %rd5;
	add.u64 %rd7, %rd2, %rd5;
	add.u64 %rd8, %rd3, %rd5;
	add.u64 %rd9, %rd4, %rd5;
	ld.global.u32 %r6, [%rd6];
	ld.global.u32 %r7, [%rd7];
	ld.global.u32 %r8, [%rd8];
	mul.lo.u32 %r9, %r6, %r7;
	sub.u32 %r10, %r9, %r8;
	st.global.u32 [%rd9], %r10;
DONE:
	ret;
}
