.version 8.0
.target sm_86
.address_size 64

.visible .entry vmul(.param .u64 vmul_a, .param .u64 vmul_b, .param .u64 vmul_c, .param .u32 vmul_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<9>;
	.reg .b64 %rd<10>;
	ld.param.u64 %rd1, [vmul_a];
	ld.param.u64 %rd2, [vmul_b];
	ld.param.u64 %rd3, [vmul_c];
	ld.param.u32 %r1, [vmul_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mul.lo.u32 %r4, %r2, %r3;
	mov.u32 %r5, %tid.x;
	add.u32 %r4, %r4, %r5;
	setp.ge.u32 %p1, %r4, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd4, %r4, 4;
	add.u64 %rd5, %rd1, %rd4;
	add.u64 %rd6, %rd2, %rd4;
	add.u64 %rd7, %rd3, %rd4;
	ld.global.u32 %r6, [%rd5];
	ld.global.u32 %r7, [%rd6];
	mul.lo.u32 %r8, %r6, %r7;
	st.global.u32 [%rd7], %r8;
DONE:
	ret;
}
