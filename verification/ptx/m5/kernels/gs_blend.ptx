.version 8.0
.target sm_86
.address_size 64

.visible .entry gs_blend(.param .u64 gs_blend_a, .param .u64 gs_blend_b, .param .u64 gs_blend_m, .param .u64 gs_blend_d, .param .u32 gs_blend_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<12>;
	.reg .b64 %rd<16>;
	ld.param.u64 %rd1, [gs_blend_a];
	ld.param.u64 %rd2, [gs_blend_b];
	ld.param.u64 %rd3, [gs_blend_m];
	ld.param.u64 %rd4, [gs_blend_d];
	ld.param.u32 %r1, [gs_blend_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mov.u32 %r5, %nctaid.x;
	mul.wide.u32 %rd5, %r2, %r3;
	cvt.u64.u32 %rd6, %r4;
	add.u64 %rd5, %rd5, %rd6;
	mul.wide.u32 %rd7, %r5, %r3;
	cvt.u64.u32 %rd8, %r1;
LOOP:
	setp.ge.u64 %p1, %rd5, %rd8;
	@%p1 bra DONE;
	shl.b64 %rd9, %rd5, 2;
	add.u64 %rd10, %rd1, %rd9;
	add.u64 %rd11, %rd2, %rd9;
	add.u64 %rd12, %rd3, %rd9;
	add.u64 %rd13, %rd4, %rd9;
	ld.global.u32 %r6, [%rd10];
	ld.global.u32 %r7, [%rd11];
	ld.global.u32 %r8, [%rd12];
	xor.b32 %r9, %r6, %r7;
	and.b32 %r10, %r9, %r8;
	xor.b32 %r11, %r10, %r7;
	st.global.u32 [%rd13], %r11;
	add.u64 %rd5, %rd5, %rd7;
	bra.uni LOOP;
DONE:
	ret;
}
