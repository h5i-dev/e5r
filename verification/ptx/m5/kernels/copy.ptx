.version 8.0
.target sm_86
.address_size 64

.visible .entry copy(.param .u64 copy_x, .param .u64 copy_y, .param .u32 copy_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<7>;
	.reg .b64 %rd<6>;
	ld.param.u64 %rd1, [copy_x];
	ld.param.u64 %rd2, [copy_y];
	ld.param.u32 %r1, [copy_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd3, %r5, 4;
	add.u64 %rd4, %rd1, %rd3;
	add.u64 %rd5, %rd2, %rd3;
	ld.global.u32 %r6, [%rd4];
	st.global.u32 [%rd5], %r6;
DONE:
	ret;
}
