.version 8.0
.target sm_86
.address_size 64

.visible .entry signed_idx_big(.param .u64 signed_idx_big_x, .param .u64 signed_idx_big_y, .param .u32 signed_idx_big_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<8>;
	.reg .b64 %rd<6>;
	ld.param.u64 %rd1, [signed_idx_big_x];
	ld.param.u64 %rd2, [signed_idx_big_y];
	ld.param.u32 %r1, [signed_idx_big_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.s32 %r5, %r2, %r3, %r4;
	setp.ge.s32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.s32 %rd3, %r5, 4;
	add.s64 %rd4, %rd1, %rd3;
	add.s64 %rd5, %rd2, %rd3;
	ld.global.u32 %r6, [%rd4];
	shl.b32 %r7, %r6, 1;
	st.global.u32 [%rd5], %r7;
DONE:
	ret;
}
