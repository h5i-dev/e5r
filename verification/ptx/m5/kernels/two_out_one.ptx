.version 8.0
.target sm_86
.address_size 64

.visible .entry two_out_one(.param .u64 two_out_one_a, .param .u64 two_out_one_b, .param .u64 two_out_one_c, .param .u32 two_out_one_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<10>;
	.reg .b64 %rd<8>;
	ld.param.u64 %rd1, [two_out_one_a];
	ld.param.u64 %rd2, [two_out_one_b];
	ld.param.u64 %rd3, [two_out_one_c];
	ld.param.s32 %r1, [two_out_one_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.s32 %r5, %r2, %r3, %r4;
	setp.ge.s32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.s32 %rd4, %r5, 4;
	add.s64 %rd5, %rd1, %rd4;
	add.s64 %rd6, %rd2, %rd4;
	add.s64 %rd7, %rd3, %rd4;
	ld.global.s32 %r6, [%rd5];
	ld.global.s32 %r7, [%rd6];
	mul.lo.s32 %r8, %r6, 3;
	sub.s32 %r9, %r8, %r7;
	st.global.s32 [%rd7], %r9;
DONE:
	ret;
}
