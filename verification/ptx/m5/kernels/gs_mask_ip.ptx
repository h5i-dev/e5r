.version 8.0
.target sm_86
.address_size 64

.visible .entry gs_mask_ip(.param .u64 gs_mask_ip_x, .param .u32 gs_mask_ip_m, .param .u32 gs_mask_ip_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<12>;
	.reg .b64 %rd<6>;
	ld.param.u64 %rd1, [gs_mask_ip_x];
	ld.param.u32 %r1, [gs_mask_ip_m];
	ld.param.u32 %r2, [gs_mask_ip_n];
	mov.u32 %r3, %ctaid.x;
	mov.u32 %r4, %ntid.x;
	mov.u32 %r5, %tid.x;
	mad.lo.u32 %r6, %r3, %r4, %r5;
	mov.u32 %r7, %nctaid.x;
	mul.lo.u32 %r8, %r7, %r4;
LOOP:
	setp.ge.u32 %p1, %r6, %r2;
	@%p1 bra DONE;
	mul.wide.u32 %rd2, %r6, 4;
	add.u64 %rd3, %rd1, %rd2;
	ld.global.u32 %r9, [%rd3];
	and.b32 %r10, %r9, %r1;
	st.global.u32 [%rd3], %r10;
	add.u32 %r6, %r6, %r8;
	bra.uni LOOP;
DONE:
	ret;
}
