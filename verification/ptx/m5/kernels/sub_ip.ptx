.version 8.0
.target sm_86
.address_size 64

.visible .entry sub_ip(.param .u64 sub_ip_x, .param .u64 sub_ip_y, .param .u32 sub_ip_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<9>;
	.reg .b64 %rd<6>;
	ld.param.u64 %rd1, [sub_ip_x];
	ld.param.u64 %rd2, [sub_ip_y];
	ld.param.u32 %r1, [sub_ip_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd3, %r5, 4;
	add.u64 %rd4, %rd1, %rd3;
	add.u64 %rd5, %rd2, %rd3;
	ld.global.u32 %r6, [%rd4];
	ld.global.u32 %r7, [%rd5];
	sub.u32 %r8, %r7, %r6;
	st.global.u32 [%rd5], %r8;
DONE:
	ret;
}
