.version 8.0
.target sm_86
.address_size 64

.visible .entry gs_sqdiff(.param .u64 gs_sqdiff_a, .param .u64 gs_sqdiff_b, .param .u64 gs_sqdiff_c, .param .u32 gs_sqdiff_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<11>;
	.reg .b64 %rd<14>;
	ld.param.u64 %rd1, [gs_sqdiff_a];
	ld.param.u64 %rd2, [gs_sqdiff_b];
	ld.param.u64 %rd3, [gs_sqdiff_c];
	ld.param.u32 %r1, [gs_sqdiff_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mov.u32 %r5, %nctaid.x;
	mul.wide.u32 %rd4, %r2, %r3;
	cvt.u64.u32 %rd5, %r4;
	add.u64 %rd4, %rd4, %rd5;
	mul.wide.u32 %rd6, %r5, %r3;
	cvt.u64.u32 %rd7, %r1;
LOOP:
	setp.ge.u64 %p1, %rd4, %rd7;
	@%p1 bra DONE;
	shl.b64 %rd8, %rd4, 2;
	add.u64 %rd9, %rd1, %rd8;
	add.u64 %rd10, %rd2, %rd8;
	add.u64 %rd11, %rd3, %rd8;
	ld.global.u32 %r6, [%rd9];
	ld.global.u32 %r7, [%rd10];
	sub.u32 %r8, %r6, %r7;
	mul.lo.u32 %r9, %r8, %r8;
	st.global.u32 [%rd11], %r9;
	add.u64 %rd4, %rd4, %rd6;
	bra.uni LOOP;
DONE:
	ret;
}
