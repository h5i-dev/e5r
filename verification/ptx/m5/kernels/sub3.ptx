.version 8.0
.target sm_86
.address_size 64

.visible .entry sub3(.param .u64 sub3_a, .param .u64 sub3_b, .param .u64 sub3_c, .param .u64 sub3_d, .param .u32 sub3_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<24>;
	.reg .b64 %rd<24>;
	ld.param.u64 %rd1, [sub3_a];
	ld.param.u64 %rd2, [sub3_b];
	ld.param.u64 %rd3, [sub3_c];
	ld.param.u64 %rd4, [sub3_d];
	ld.param.u32 %r1, [sub3_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd10, %r5, 4;
	add.u64 %rd11, %rd1, %rd10;
	add.u64 %rd12, %rd2, %rd10;
	add.u64 %rd13, %rd3, %rd10;
	add.u64 %rd14, %rd4, %rd10;
	ld.global.u32 %r10, [%rd11];
	ld.global.u32 %r11, [%rd12];
	ld.global.u32 %r12, [%rd13];
	sub.u32 %r9, %r10, %r11;
	sub.u32 %r9, %r9, %r12;
	st.global.u32 [%rd14], %r9;
DONE:
	ret;
}
