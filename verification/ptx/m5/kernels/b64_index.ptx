.version 8.0
.target sm_86
.address_size 64

.visible .entry b64_index(.param .u64 b64_index_x, .param .u64 b64_index_y, .param .u32 b64_index_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<8>;
	.reg .b64 %rd<7>;
	ld.param.u64 %rd1, [b64_index_x];
	ld.param.u64 %rd2, [b64_index_y];
	ld.param.u32 %r1, [b64_index_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	cvt.u64.u32 %rd3, %r5;
	shl.b64 %rd4, %rd3, 2;
	add.u64 %rd5, %rd1, %rd4;
	add.u64 %rd6, %rd2, %rd4;
	ld.global.u32 %r6, [%rd5];
	add.u32 %r7, %r6, 7;
	st.global.u32 [%rd6], %r7;
DONE:
	ret;
}
