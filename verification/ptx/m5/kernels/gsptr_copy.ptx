.version 8.0
.target sm_86
.address_size 64

.visible .entry gsptr_copy(.param .u64 gsptr_copy_x, .param .u64 gsptr_copy_y, .param .u32 gsptr_copy_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<10>;
	.reg .b64 %rd<12>;
	ld.param.u64 %rd1, [gsptr_copy_x];
	ld.param.u64 %rd2, [gsptr_copy_y];
	ld.param.u32 %r2, [gsptr_copy_n];
	mov.u32 %r3, %ctaid.x;
	mov.u32 %r4, %ntid.x;
	mov.u32 %r5, %tid.x;
	mov.u32 %r6, %nctaid.x;
	mul.wide.u32 %rd3, %r3, %r4;
	cvt.u64.u32 %rd4, %r5;
	add.u64 %rd3, %rd3, %rd4;
	mul.wide.u32 %rd5, %r6, %r4;
	cvt.u64.u32 %rd6, %r2;
	shl.b64 %rd7, %rd3, 2;
	add.u64 %rd8, %rd1, %rd7;
	add.u64 %rd9, %rd2, %rd7;
	shl.b64 %rd10, %rd5, 2;
LOOP:
	setp.ge.u64 %p1, %rd3, %rd6;
	@%p1 bra DONE;
	ld.global.u32 %r7, [%rd8];
	st.global.u32 [%rd9], %r7;
	add.u64 %rd3, %rd3, %rd5;
	add.u64 %rd8, %rd8, %rd10;
	add.u64 %rd9, %rd9, %rd10;
	bra.uni LOOP;
DONE:
	ret;
}
