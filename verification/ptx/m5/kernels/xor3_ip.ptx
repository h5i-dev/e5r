.version 8.0
.target sm_86
.address_size 64

.visible .entry xor3_ip(.param .u64 xor3_ip_x, .param .u64 xor3_ip_y, .param .u64 xor3_ip_z, .param .u32 xor3_ip_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<11>;
	.reg .b64 %rd<8>;
	ld.param.u64 %rd1, [xor3_ip_x];
	ld.param.u64 %rd2, [xor3_ip_y];
	ld.param.u64 %rd3, [xor3_ip_z];
	ld.param.u32 %r1, [xor3_ip_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd4, %r5, 4;
	add.u64 %rd5, %rd1, %rd4;
	add.u64 %rd6, %rd2, %rd4;
	add.u64 %rd7, %rd3, %rd4;
	ld.global.u32 %r6, [%rd5];
	ld.global.u32 %r7, [%rd6];
	ld.global.u32 %r8, [%rd7];
	xor.b32 %r9, %r6, %r7;
	xor.b32 %r10, %r8, %r9;
	st.global.u32 [%rd7], %r10;
DONE:
	ret;
}
