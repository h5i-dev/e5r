.version 8.0
.target sm_86
.address_size 64

.visible .entry gs_no_tid(.param .u64 gs_no_tid_x, .param .u64 gs_no_tid_y, .param .u32 gs_no_tid_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<10>;
	.reg .b64 %rd<10>;
	ld.param.u64 %rd1, [gs_no_tid_x];
	ld.param.u64 %rd2, [gs_no_tid_y];
	ld.param.u32 %r1, [gs_no_tid_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r5, %nctaid.x;
	mul.wide.u32 %rd3, %r2, %r3;
	mul.wide.u32 %rd5, %r5, %r3;
	cvt.u64.u32 %rd6, %r1;
LOOP:
	setp.ge.u64 %p1, %rd3, %rd6;
	@%p1 bra DONE;
	shl.b64 %rd7, %rd3, 2;
	add.u64 %rd8, %rd1, %rd7;
	add.u64 %rd9, %rd2, %rd7;
	ld.global.u32 %r6, [%rd8];
	add.u32 %r7, %r6, 1;
	st.global.u32 [%rd9], %r7;
	add.u64 %rd3, %rd3, %rd5;
	bra.uni LOOP;
DONE:
	ret;
}
