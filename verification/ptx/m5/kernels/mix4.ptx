.version 8.0
.target sm_86
.address_size 64

.visible .entry mix4(.param .u64 mix4_a, .param .u64 mix4_b, .param .u64 mix4_c, .param .u64 mix4_d, .param .u64 mix4_e, .param .u32 mix4_n)
{
	.reg .pred %p<2>;
	.reg .b32 %r<24>;
	.reg .b64 %rd<24>;
	ld.param.u64 %rd1, [mix4_a];
	ld.param.u64 %rd2, [mix4_b];
	ld.param.u64 %rd3, [mix4_c];
	ld.param.u64 %rd4, [mix4_d];
	ld.param.u64 %rd5, [mix4_e];
	ld.param.u32 %r1, [mix4_n];
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mov.u32 %r4, %tid.x;
	mad.lo.u32 %r5, %r2, %r3, %r4;
	setp.ge.u32 %p1, %r5, %r1;
	@%p1 bra DONE;
	mul.wide.u32 %rd10, %r5, 4;
	add.u64 %rd11, %rd1, %rd10;
	add.u64 %rd12, %rd2, %rd10;
	add.u64 %rd13, %rd3, %rd10;
	add.u64 %rd14, %rd4, %rd10;
	add.u64 %rd15, %rd5, %rd10;
	ld.global.u32 %r10, [%rd11];
	ld.global.u32 %r11, [%rd12];
	ld.global.u32 %r12, [%rd13];
	ld.global.u32 %r13, [%rd14];
	mul.lo.u32 %r9, %r10, %r11;
	mad.lo.u32 %r9, %r12, %r13, %r9;
	st.global.u32 [%rd15], %r9;
DONE:
	ret;
}
