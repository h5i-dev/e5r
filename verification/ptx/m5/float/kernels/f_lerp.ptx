.version 8.0
.target sm_86
.address_size 64

.visible .entry f_lerp(
	.param .u64 f_lerp_a,
	.param .u64 f_lerp_b,
	.param .u64 f_lerp_c,
	.param .f32 f_lerp_t,
	.param .u32 f_lerp_n
)
{
	.reg .pred 	%p<2>;
	.reg .f32 	%f<16>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<16>;

	ld.param.u64 	%rd1, [f_lerp_a];
	ld.param.u64 	%rd2, [f_lerp_b];
	ld.param.u64 	%rd3, [f_lerp_c];
	ld.param.f32 	%f10, [f_lerp_t];
	ld.param.u32 	%r1, [f_lerp_n];
	mov.u32 	%r2, %ctaid.x;
	mov.u32 	%r3, %ntid.x;
	mov.u32 	%r4, %tid.x;
	mad.lo.u32 	%r5, %r2, %r3, %r4;
	setp.ge.u32 	%p1, %r5, %r1;
	@%p1 bra 	$L_done;
	mul.wide.u32 	%rd8, %r5, 4;
	add.u64 	%rd9, %rd1, %rd8;
	add.u64 	%rd10, %rd2, %rd8;
	add.u64 	%rd11, %rd3, %rd8;
	ld.global.f32 	%f1, [%rd9];
	ld.global.f32 	%f2, [%rd10];
	sub.rn.f32 	%f5, %f2, %f1;
	fma.rn.f32 	%f9, %f10, %f5, %f1;
	st.global.f32 	[%rd11], %f9;
$L_done:
	ret;
}
