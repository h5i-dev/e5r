  "task": "d[i] = a[i] * b[i] + c[i], grid-stride",
  "arrays": [
   "a",
   "b",
   "c",
   "d"
  ],
  "output": "d",
  "length": "n",
  "scalars": [],
  "element": "gs_fma_a * gs_fma_b + gs_fma_c",
  "schedule": {
   "kind": "stride",
   "bound": "2^64",
   "head": "LOOP",
   "registers": {
    "%rd1": "base gs_fma_a",
    "%rd2": "base gs_fma_b",
    "%rd3": "base gs_fma_c",
    "%rd4": "base gs_fma_d",
    "%rd5": "index64",
    "%rd7": "stride64",
    "%rd8": "length"
   }
  },
  "batch": "batch2.txt"
 },
