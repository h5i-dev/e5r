// y[i] = a * x[i] + y[i] (mod 2^32) for every i < n, with a grid-stride loop
// so any legal launch covers any n. Written directly in PTX; the index and
// stride are 64-bit so neither can wrap.
.version 8.0
.target sm_80
.address_size 64

.visible .entry saxpy(
	.param .u64 saxpy_x,
	.param .u64 saxpy_y,
	.param .u32 saxpy_a,
	.param .u32 saxpy_n
)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<10>;
	.reg .b64 	%rd<10>;

	ld.param.u64 	%rd1, [saxpy_x];
	ld.param.u64 	%rd2, [saxpy_y];
	ld.param.u32 	%r1, [saxpy_a];
	ld.param.u32 	%r2, [saxpy_n];
	cvta.to.global.u64 	%rd1, %rd1;
	cvta.to.global.u64 	%rd2, %rd2;
	mov.u32 	%r3, %ctaid.x;
	mov.u32 	%r4, %ntid.x;
	mov.u32 	%r5, %tid.x;
	mov.u32 	%r6, %nctaid.x;
	mul.wide.u32 	%rd3, %r3, %r4;
	cvt.u64.u32 	%rd4, %r5;
	add.u64 	%rd3, %rd3, %rd4;
	mul.wide.u32 	%rd5, %r6, %r4;
	cvt.u64.u32 	%rd6, %r2;
$L_loop:
	setp.ge.u64 	%p1, %rd3, %rd6;
	@%p1 bra 	$L_done;
	shl.b64 	%rd7, %rd3, 2;
	add.u64 	%rd8, %rd1, %rd7;
	add.u64 	%rd9, %rd2, %rd7;
	ld.global.u32 	%r7, [%rd8];
	ld.global.u32 	%r8, [%rd9];
	mad.lo.u32 	%r9, %r1, %r7, %r8;
	st.global.u32 	[%rd9], %r9;
	add.u64 	%rd3, %rd3, %rd5;
	bra.uni 	$L_loop;
$L_done:
	ret;
}
