import Lake
open Lake DSL

-- Core Lean only: no `require`, so nothing is fetched (docs/verification-ptx.md).
package ptx

@[default_target]
lean_lib Ptx where
  globs := #[.andSubmodules `Ptx]

-- The model's side of the GPU differential test (scripts/check-ptx-difftest.sh).
-- Not a default target: Diff/Kernels.lean is generated by that script.
lean_lib Diff where
  roots := #[`Diff.Kernels]

lean_exe ptxdiff where
  root := `Diff.Main

-- The independent checker for supplied proofs (`e5r-verify ptx check --proof`).
lean_exe proofcheck where
  root := `Checker.ProofCheck
