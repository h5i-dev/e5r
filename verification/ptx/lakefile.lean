import Lake
open Lake DSL

-- Core Lean and local shared checker support only; no remote dependencies.
package ptx

require e5rVerification from "../common"

@[default_target]
lean_lib Ptx where
  globs := #[.andSubmodules `Ptx]

-- The model's side of the GPU differential test (scripts/check-ptx-difftest.sh).
-- Not a default target: Diff/Kernels.lean is generated by that script.
lean_lib Diff where
  roots := #[`Diff.Kernels]

lean_exe ptxdiff where
  root := `Diff.Main

-- The independent checker for supplied proofs (`e5r ptx check --proof`).
lean_exe proofcheck where
  root := `Checker.ProofCheck
