import Lake
open Lake DSL

-- Lake builds only the native test tools. Proof checking runs plain `lean`
-- module by module from tools/check.py, so no stale build output is trusted.
package rv32

lean_lib Theories where
  globs := #[.submodules `Theories]

lean_lib FirmwareImage where
  roots := #[`Projects.hifive1.Image, `Projects.hifive1.Config]

lean_exe replay where
  root := `tools.ReplayFw

lean_exe replay_virt where
  root := `tools.ReplayVirt

-- The packed RMK ELF (generated by tools/pack_elf.py; gitignored).
lean_lib RmkImage where
  roots := #[`Projects.rmk.QemuRiscvRynk.Image]

lean_exe analyze_firmware where
  root := `tools.AnalyzeFirmware

lean_lib Tools where
  roots := #[`tools.Analyze, `tools.ReplayLib, `tools.Replay]

-- The proved ring-head summary the analyzer may use (`E5R_RING=1`).
lean_lib Hybrid where
  roots := #[`Projects.hifive1.hybrid.Ring, `Projects.hifive1.hybrid.RingAI,
    `Projects.hifive1.hybrid.Tail, `Projects.hifive1.hybrid.TailAI]

lean_exe replay_isa where
  root := `tools.ReplayIsa

lean_exe trace_guard where
  root := `tools.TraceGuard
