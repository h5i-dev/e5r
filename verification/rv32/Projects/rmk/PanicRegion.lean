/-- The five calls, each with the return-address value its `auipc` set. -/
def panicJ : List (Word × Word) := [(0x8001f872, 0x8001f86e), (0x8001f980, 0x8001d97c), (0x8001fb42, 0x8001fb3e), (0x8001fb88, 0x8001fb84), (0x8001fbc6, 0x8001fbc2)]

/-- Inside the panic path: at one of its pcs, or at one of its calls with ra as its `auipc` set. -/
def PanicRg (m : Machine) : Prop :=
  m.core.pc ∈ panicS ∨ ∃ q ∈ panicJ, m.core.pc = q.1 ∧ m.core.get 1 = q.2

