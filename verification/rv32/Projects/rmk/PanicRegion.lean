    · have e := PanicPc.pc_store (by rw [h]; decide) (by rw [h]; exact f8001f846) hd; left; rw [e, h]; decide
    · have e := PanicPc.pc_store (by rw [h]; decide) (by rw [h]; exact f8001f848) hd; left; rw [e, h]; decide
