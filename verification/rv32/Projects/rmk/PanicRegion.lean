/-
  The panic path of the pinned RMK image absorbs every run: once a quiet deterministic run is in
  `slice_index_fail` (0x8001fafc), `panic_bounds_check` (0x8001f83a), `panic_fmt` (0x8001f956) or
  the panic-halt loop `rust_begin_unwind` (0x8001e148, `j .`), it never leaves.

  Original e5r code, Apache-2.0.

  PROVED here: next-pc lemmas per instruction kind (`PanicPc.pc_*`, from `DetStep` alone: a step
  that succeeds under every oracle goes to the pc its instruction names); `rg_step` (GENERATED by
  tools/gen_panic_region.py: one case per instruction of the path) and `panic_absorbing`.
  With `reach_on_runs` (Projects/rmk/Reach.lean), `reach_no_panic` turns "every checkpoint run ends outside the panic path" into
  "no reachable machine is at a panic pc", without knowing the intermediate pcs of the runs.
-/
import Projects.rmk.PanicFetch
import Projects.rmk.Reach

set_option maxRecDepth 100000

namespace E5R.Rmk.PanicPc
open E5R E5R.Rmk
variable {m m₁ : Machine} {len : Word}

theorem ok_core {X : Core} {R R' : Word → BitVec 8} {evs : List Event} {c : Core}
    (h : Result.ok X R [] = Result.ok c R' evs) : c = X := by injection h with h1; exact h1.symm

theorem store_core {o : Oracle} {w a v atm} {c' c : Core} {ram ram' : Word → BitVec 8} {i evs evs'}
    (h : interp B img o (.store w a v atm (.done c')) ram i evs = .ok c ram' evs') : c = c' := by
  unfold interp at h
  split at h
  · cases h
  · split at h
    · simp only [interp] at h; injection h with h1; exact h1.symm
    · split at h
      · cases h
      · split at h
        · split at h
          · simp only [interp] at h; injection h with h1; exact h1.symm
          · cases h
        · cases h

theorem jump_core {c c' : Core} {t : Word} {ram ram' : Word → BitVec 8} {evs : List Event} {o : Oracle}
    (h : interp B img o (jump c t) ram 0 [] = .ok c' ram' evs) : c'.pc = t := by
  unfold jump at h
  split at h
  · cases h
  · simp only [interp] at h; injection h with h1; rw [← h1]

theorem pc_op {op rd rs1 rs2} (hal : m.core.pc.getLsbD 0 = false)
    (hf : fetchDecode img m.core.pc = some (.op op rd rs1 rs2, len)) (hd : DetStep B img m m₁) :
    m₁.core.pc = m.core.pc + len := by
  have := hd (fun _ => 0); rw [stepInstr_of hal hf, exec_op] at this
  rw [ok_core this]; rfl

theorem pc_opimm {op rd rs1 imm} (hal : m.core.pc.getLsbD 0 = false)
    (hf : fetchDecode img m.core.pc = some (.opimm op rd rs1 imm, len)) (hd : DetStep B img m m₁) :
    m₁.core.pc = m.core.pc + len := by
  have := hd (fun _ => 0); rw [stepInstr_of hal hf, exec_opimm] at this
  rw [ok_core this]; rfl

theorem pc_lui {rd imm} (hal : m.core.pc.getLsbD 0 = false)
    (hf : fetchDecode img m.core.pc = some (.lui rd imm, len)) (hd : DetStep B img m m₁) :
    m₁.core.pc = m.core.pc + len := by
  have := hd (fun _ => 0); rw [stepInstr_of hal hf, exec_lui] at this
  rw [ok_core this]; rfl

theorem pc_auipc {imm} (hal : m.core.pc.getLsbD 0 = false)
    (hf : fetchDecode img m.core.pc = some (.auipc 1 imm, len)) (hd : DetStep B img m m₁) :
    m₁.core.pc = m.core.pc + len ∧ m₁.core.get 1 = m.core.pc + imm := by
  have := hd (fun _ => 0); rw [stepInstr_of hal hf, exec_auipc] at this
  rw [ok_core this]
  exact ⟨rfl, Core.wr_get_self _ _ _ _ (by decide)⟩

theorem pc_store {w rs1 rs2 off} (hal : m.core.pc.getLsbD 0 = false)
    (hf : fetchDecode img m.core.pc = some (.store w rs1 rs2 off, len)) (hd : DetStep B img m m₁) :
    m₁.core.pc = m.core.pc + len := by
  have := hd (fun _ => 0); rw [stepInstr_of hal hf, exec_store] at this
  rw [store_core this]; rfl

theorem pc_branch {cond rs1 rs2 off} (hal : m.core.pc.getLsbD 0 = false)
    (hf : fetchDecode img m.core.pc = some (.branch cond rs1 rs2 off, len)) (hd : DetStep B img m m₁) :
    m₁.core.pc = m.core.pc + len ∨ m₁.core.pc = m.core.pc + off := by
  have := hd (fun _ => 0); rw [stepInstr_of hal hf, exec_branch] at this
  split at this
  · exact .inr (jump_core this)
  · simp only [interp] at this; injection this with h1; rw [← h1]; exact .inl rfl

theorem pc_jal {rd off} (hal : m.core.pc.getLsbD 0 = false)
    (hf : fetchDecode img m.core.pc = some (.jal rd off, len)) (hd : DetStep B img m m₁) :
    m₁.core.pc = m.core.pc + off := by
  have := hd (fun _ => 0); rw [stepInstr_of hal hf, exec_jal] at this
  exact jump_core this

theorem pc_jalr {rd rs1 off} (hal : m.core.pc.getLsbD 0 = false)
    (hf : fetchDecode img m.core.pc = some (.jalr rd rs1 off, len)) (hd : DetStep B img m m₁) :
    m₁.core.pc = (m.core.get rs1 + off) &&& ~~~1 := by
  have := hd (fun _ => 0); rw [stepInstr_of hal hf, exec_jalr] at this
  rw [jump_core this]

end E5R.Rmk.PanicPc

namespace E5R.Rmk.Panic
