  · simp only [panicJ, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl | rfl | rfl | rfl
    · have e := PanicPc.pc_jalr (by rw [hpc]; decide) (by rw [hpc]; exact f8001f872) hd; left; rw [e, hra]; decide
