    rw [exec_branch, (show re2.get 9 = alu .add (e.get 9) 0x00000001#32 by simp [re1, reR1, re2, Core.wr_get_ne, Core.wr_get_self]), (show re2.get 20 = e.get 20 by simp [re1, reR1, re2, Core.wr_get_ne, Core.wr_get_self]), (show taken .ne (e.get 20) (alu .add (e.get 9) 0x00000001#32) = false by exact hwhy_800043a2)]; simp only [↓reduceIte, Bool.false_eq_true]; rfl
  have s3 : DetStep B img ⟨re3, reR1⟩ ⟨re4, reR1⟩ := by
    refine detStep_of (by show (0x800043a6 : Word).getLsbD 0 = false; decide) f800043a6 fun o => ?_
    rw [exec_op, Core.get_zero, (show re3.get 20 = e.get 20 by simp [re1, reR1, re2, re3, Core.wr_get_ne, Core.wr_get_self])]; rfl
  exact .step hq s0 (.step qre1 s1 (.step qre2 s2 (.single qre3 s3)))

end E5R.Rmk.Deframer.Rx
