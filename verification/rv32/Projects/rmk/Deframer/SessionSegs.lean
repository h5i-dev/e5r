  have s8 : DetStep B img ⟨sd8, sdR1⟩ ⟨sd9, sdR1⟩ := by
    refine detStep_of (by show (0x80003e68 : Word).getLsbD 0 = false; decide) f80003e68 fun o => ?_
    rw [exec_auipc]; rfl
  have s9 : DetStep B img ⟨sd9, sdR1⟩ ⟨sd10, sdR1⟩ := by
