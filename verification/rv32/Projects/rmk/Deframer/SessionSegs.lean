    rw [exec_jalr, (show sd9.get 1 = (0x80003e68 + 0x00018000#32) by simp [sd1, sd2, sdR1, sd3, sd4, sd5, sd6, sd7, sd8, sd9, Core.wr_get_ne, Core.wr_get_self]), show ((0x80003e68 + 0x00018000#32)) + 0x0000055e#32 &&& ~~~1 = 0x8001c3c6 by decide, jump_ok _ _ (by decide)]; rfl
  exact .step hq s0 (.step qsd1 s1 (.step qsd2 s2 (.step qsd3 s3 (.step qsd4 s4 (.step qsd5 s5 (.step qsd6 s6 (.step qsd7 s7 (.step qsd8 s8 (.single qsd9 s9)))))))))

def stailCore (e : Core) (M : Word → BitVec 8) : Core :=
  (e.wr 18 (alu .add (0) (e.get 10)) 0x80003f7a).wr 20 (alu .add (0) (e.get 11)) 0x80003f7c

def stailRam (e : Core) (M : Word → BitVec 8) : Word → BitVec 8 :=
  M

theorem stail (e : Core) (M : Word → BitVec 8) (hpc : e.pc = 0x80003f78) (hq : Quiet e) :
    QRun B img 2 ⟨e, M⟩ ⟨stailCore e M, stailRam e M⟩ := by
  let st1 := e.wr 18 (alu .add (0) (e.get 10)) 0x80003f7a
  let st2 := st1.wr 20 (alu .add (0) (e.get 11)) 0x80003f7c
  have qst1 : Quiet st1 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) hq
  have qst2 : Quiet st2 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qst1
  have s0 : DetStep B img ⟨e, M⟩ ⟨st1, M⟩ := by
    refine detStep_of (by rw [hpc]; decide) (by rw [hpc]; exact f80003f78) fun o => ?_
    rw [exec_op, Core.get_zero, (show e.get 10 = e.get 10 by simp [Core.wr_get_ne, Core.wr_get_self]), hpc]; rfl
  have s1 : DetStep B img ⟨st1, M⟩ ⟨st2, M⟩ := by
    refine detStep_of (by show (0x80003f7a : Word).getLsbD 0 = false; decide) f80003f7a fun o => ?_
    rw [exec_op, Core.get_zero, (show st1.get 11 = e.get 11 by simp [st1, Core.wr_get_ne, Core.wr_get_self])]; rfl
  exact .step hq s0 (.single qst1 s1)

