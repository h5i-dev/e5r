    rw [exec_op, (show e.get 10 = e.get 10 by simp [Core.wr_get_ne, Core.wr_get_self]), (show e.get 19 = e.get 19 by simp [Core.wr_get_ne, Core.wr_get_self]), hpc]; rfl
  have s1 : DetStep B img ⟨sd1, M⟩ ⟨sd2, M⟩ := by
    refine detStep_of (by show (0x80003e52 : Word).getLsbD 0 = false; decide) f80003e52 fun o => ?_
    rw [exec_opimm, Core.get_zero]; rfl
  have s2 : DetStep B img ⟨sd2, M⟩ ⟨sd3, sdR1⟩ := by
