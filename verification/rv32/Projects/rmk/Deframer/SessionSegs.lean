  let sd8 := sd7.wr 13 (alu .add (0) (e.get 18)) 0x80003e68
  let sd9 := sd8.wr 1 (0x80003e68 + 0x00018000#32) 0x80003e6c
  let sd10 := sd9.wr 1 0x80003e70 0x8001c3c6
  have qsd1 : Quiet sd1 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) hq
  have qsd2 : Quiet sd2 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qsd1
