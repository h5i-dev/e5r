  have qsd6 : Quiet sd6 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qsd5
  have qsd7 : Quiet sd7 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qsd6
  have qsd8 : Quiet sd8 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qsd7
  have qsd9 : Quiet sd9 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qsd8
  have qsd10 : Quiet sd10 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qsd9
  have s0 : DetStep B img ⟨e, M⟩ ⟨sd1, M⟩ := by
