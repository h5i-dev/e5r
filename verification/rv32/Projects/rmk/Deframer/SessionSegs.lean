    rw [exec_store, (show sd2.get 22 = e.get 22 by simp [sd1, sd2, Core.wr_get_ne, Core.wr_get_self]), (show sd2.get 10 = e.get 10 by simp [sd1, sd2, Core.wr_get_ne, Core.wr_get_self]), interp_store_ram (w := .w) o (show (e.get 22 + 0x000002db#32).toNat % 4 = 0 by exact hal_80003e56) (show B.inRam (e.get 22 + 0x000002db#32) 4 = true by exact hin_80003e56)]; rfl
  have s3 : DetStep B img ⟨sd3, sdR1⟩ ⟨sd4, sdR1⟩ := by
