    (hcf : (ramRead R (d.get 10) .w).toNat ≤ (ramRead R (d.get 10 + 0x4#32) .w).toNat) :
    QRun B img 12 ⟨d, R⟩ ⟨nentryCore d R, nentryRam d R⟩ := by
  let j1 := d.wr 18 (alu .add (0) (d.get 12)) 0x8001d458
  let j2 := j1.wr 8 (ramRead R (d.get 10 + 0x00000004#32) .w) 0x8001d45a
  let j3 := j2.wr 9 (ramRead R (d.get 10) .w) 0x8001d45c
  let j4 := j3.goto 0x8001d460
  let j5 := j4.goto 0x8001d464
  let j6 := j5.wr 19 (alu .add (0) (d.get 10)) 0x8001d466
  let j7 := j6.wr 20 (alu .add (0) (d.get 11)) 0x8001d468
  let j8 := j7.wr 23 (extend .b false (ramRead R (d.get 10 + 0x00000008#32) .b)) 0x8001d46c
  let j9 := j8.wr 24 (alu .sub (0) (ramRead R (d.get 10 + 0x00000004#32) .w)) 0x8001d470
  let j10 := j9.wr 25 (alu .add (0) 0xffffffff#32) 0x8001d472
  let j11 := j10.wr 26 (alu .add (0) 0x00000002#32) 0x8001d474
  let j12 := j11.wr 10 (alu .add (0) (extend .b false (ramRead R (d.get 10 + 0x00000008#32) .b))) 0x8001d476
  have qj1 : Quiet j1 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) hq
  have qj2 : Quiet j2 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qj1
  have qj3 : Quiet j3 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qj2
  have qj4 : Quiet j4 := Quiet.of_sameCsr (Core.sameCsr_goto _ _) qj3
  have qj5 : Quiet j5 := Quiet.of_sameCsr (Core.sameCsr_goto _ _) qj4
  have qj6 : Quiet j6 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qj5
  have qj7 : Quiet j7 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qj6
  have qj8 : Quiet j8 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qj7
  have qj9 : Quiet j9 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qj8
  have qj10 : Quiet j10 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qj9
  have qj11 : Quiet j11 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qj10
  have qj12 : Quiet j12 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) qj11
  have s0 : DetStep B img ⟨d, R⟩ ⟨j1, R⟩ := by
    refine detStep_of (by rw [hpc]; decide) (by rw [hpc]; exact f8001d456) fun o => ?_
    rw [exec_op, Core.get_zero, (show d.get 12 = d.get 12 by simp [Core.wr_get_ne, Core.wr_get_self]), hpc]; rfl
  have s1 : DetStep B img ⟨j1, R⟩ ⟨j2, R⟩ := by
    refine detStep_of (by show (0x8001d458 : Word).getLsbD 0 = false; decide) f8001d458 fun o => ?_
    rw [exec_load, (show j1.get 10 = d.get 10 by simp [j1, Core.wr_get_ne, Core.wr_get_self]), interp_load_ram (w := .w) o (show (d.get 10 + 0x00000004#32).toNat % 4 = 0 by bv_omega) (show B.inRam (d.get 10 + 0x00000004#32) 4 = true by rw [B_ram]; constructor <;> bv_omega)]; rfl
  have s2 : DetStep B img ⟨j2, R⟩ ⟨j3, R⟩ := by
    refine detStep_of (by show (0x8001d45a : Word).getLsbD 0 = false; decide) f8001d45a fun o => ?_
    rw [exec_load, (show j2.get 10 = d.get 10 by simp [j1, j2, Core.wr_get_ne, Core.wr_get_self]), BitVec.add_zero, interp_load_ram (w := .w) o (show (d.get 10).toNat % 4 = 0 by bv_omega) (show B.inRam (d.get 10) 4 = true by rw [B_ram]; constructor <;> bv_omega)]; rfl
  have s3 : DetStep B img ⟨j3, R⟩ ⟨j4, R⟩ := by
    refine detStep_of (by show (0x8001d45c : Word).getLsbD 0 = false; decide) f8001d45c fun o => ?_
    rw [exec_branch, (show j3.get 8 = ramRead R (d.get 10 + 0x00000004#32) .w by simp [j1, j2, j3, Core.wr_get_ne, Core.wr_get_self]), (show j3.get 12 = d.get 12 by simp [j1, j2, j3, Core.wr_get_ne, Core.wr_get_self]), (show taken .ltu (d.get 12) (ramRead R (d.get 10 + 0x00000004#32) .w) = false by simp only [taken, BitVec.ult, decide_eq_false_iff_not]; omega)]; simp only [↓reduceIte, Bool.false_eq_true]; rfl
  have s4 : DetStep B img ⟨j4, R⟩ ⟨j5, R⟩ := by
    refine detStep_of (by show (0x8001d460 : Word).getLsbD 0 = false; decide) f8001d460 fun o => ?_
    rw [exec_branch, (show j4.get 8 = ramRead R (d.get 10 + 0x00000004#32) .w by simp [j1, j2, j3, j4, Core.wr_get_ne, Core.wr_get_self]), (show j4.get 9 = ramRead R (d.get 10) .w by simp [j1, j2, j3, j4, Core.wr_get_ne, Core.wr_get_self]), (show taken .ltu (ramRead R (d.get 10 + 0x00000004#32) .w) (ramRead R (d.get 10) .w) = false by simp only [taken, BitVec.ult, decide_eq_false_iff_not]; omega)]; simp only [↓reduceIte, Bool.false_eq_true]; rfl
  have s5 : DetStep B img ⟨j5, R⟩ ⟨j6, R⟩ := by
    refine detStep_of (by show (0x8001d464 : Word).getLsbD 0 = false; decide) f8001d464 fun o => ?_
    rw [exec_op, Core.get_zero, (show j5.get 10 = d.get 10 by simp [j1, j2, j3, j4, j5, Core.wr_get_ne, Core.wr_get_self])]; rfl
  have s6 : DetStep B img ⟨j6, R⟩ ⟨j7, R⟩ := by
    refine detStep_of (by show (0x8001d466 : Word).getLsbD 0 = false; decide) f8001d466 fun o => ?_
    rw [exec_op, Core.get_zero, (show j6.get 11 = d.get 11 by simp [j1, j2, j3, j4, j5, j6, Core.wr_get_ne, Core.wr_get_self])]; rfl
  have s7 : DetStep B img ⟨j7, R⟩ ⟨j8, R⟩ := by
    refine detStep_of (by show (0x8001d468 : Word).getLsbD 0 = false; decide) f8001d468 fun o => ?_
    rw [exec_load, (show j7.get 10 = d.get 10 by simp [j1, j2, j3, j4, j5, j6, j7, Core.wr_get_ne, Core.wr_get_self]), interp_load_ram (w := .b) o (show (d.get 10 + 0x00000008#32).toNat % 1 = 0 by omega) (show B.inRam (d.get 10 + 0x00000008#32) 1 = true by rw [B_ram]; constructor <;> bv_omega)]; rfl
  have s8 : DetStep B img ⟨j8, R⟩ ⟨j9, R⟩ := by
    refine detStep_of (by show (0x8001d46c : Word).getLsbD 0 = false; decide) f8001d46c fun o => ?_
    rw [exec_op, Core.get_zero, (show j8.get 8 = ramRead R (d.get 10 + 0x00000004#32) .w by simp [j1, j2, j3, j4, j5, j6, j7, j8, Core.wr_get_ne, Core.wr_get_self])]; rfl
  have s9 : DetStep B img ⟨j9, R⟩ ⟨j10, R⟩ := by
    refine detStep_of (by show (0x8001d470 : Word).getLsbD 0 = false; decide) f8001d470 fun o => ?_
    rw [exec_opimm, Core.get_zero]; rfl
  have s10 : DetStep B img ⟨j10, R⟩ ⟨j11, R⟩ := by
    refine detStep_of (by show (0x8001d472 : Word).getLsbD 0 = false; decide) f8001d472 fun o => ?_
    rw [exec_opimm, Core.get_zero]; rfl
  have s11 : DetStep B img ⟨j11, R⟩ ⟨j12, R⟩ := by
    refine detStep_of (by show (0x8001d474 : Word).getLsbD 0 = false; decide) f8001d474 fun o => ?_
    rw [exec_op, Core.get_zero, (show j11.get 23 = extend .b false (ramRead R (d.get 10 + 0x00000008#32) .b) by simp [j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, j11, Core.wr_get_ne, Core.wr_get_self])]; rfl
  exact .step hq s0 (.step qj1 s1 (.step qj2 s2 (.step qj3 s3 (.step qj4 s4 (.step qj5 s5 (.step qj6 s6 (.step qj7 s7 (.step qj8 s8 (.step qj9 s9 (.step qj10 s10 (.single qj11 s11)))))))))))

/-! ## The delimiter scan loop: 0x8001d486 .. 0x8001d498 -/

theorem lbu_val (M : Word → BitVec 8) (a : Word) :
    extend .b false (ramRead M a .b) = BitVec.ofNat 32 (M a).toNat := by
  apply BitVec.eq_of_toNat_eq
  have := (M a).isLt
  simp only [extend, ramRead, BitVec.toNat_and, BitVec.toNat_ofNat]
  rw [show BitVec.toNat (255 : Word) = 2 ^ 8 - 1 from rfl, Nat.and_two_pow_sub_one_eq_mod]
  omega

theorem byte_zero (b : BitVec 8) : (BitVec.ofNat 32 b.toNat = 0) ↔ b = 0 := by
  constructor
  · intro h; apply BitVec.eq_of_toNat_eq; have h2 := congrArg BitVec.toNat h; have := b.isLt
    simp only [BitVec.toNat_ofNat] at h2; rw [show BitVec.toNat (0 : Word) = 0 from rfl] at h2
    show b.toNat = 0; omega
  · intro h; subst h; rfl

theorem scan_last (f cur : Word) (i n : Nat) (hn : n = (f - cur).toNat) (hi : i + 1 ≤ n) :
    (alu .add (alu .sub 0 f) cur = alu .add (0 - BitVec.ofNat 32 i) 0xffffffff#32) ↔ i + 1 = n := by
  simp only [alu_add, alu_sub]
  constructor
  · intro h; have := congrArg BitVec.toNat h; subst hn; bv_omega
  · intro h; subst hn; bv_omega

theorem dec_succ (i : Nat) : alu .add (0 - BitVec.ofNat 32 i) 0xffffffff#32 = 0 - BitVec.ofNat 32 (i + 1) := by
  simp only [alu_add]; bv_omega
theorem inc_succ (b : Word) (i : Nat) : alu .add (b + BitVec.ofNat 32 i) 0x1#32 = b + BitVec.ofNat 32 (i + 1) := by
  simp only [alu_add]; bv_omega

/-- The delimiter scan 0x8001d486 .. 0x8001d498: from byte i on, either a zero byte j is found
    (at 0x8001d49a, a2 = -j) or none of bytes i .. n-1 is zero (at 0x8001d4f8). Only a2, a4, a5
    change; RAM is read only. -/
theorem scan (M : Word → BitVec 8) (f cur buf : Word) (n : Nat) (hn : n = (f - cur).toNat)
    (hin : ∀ t, t < n → B.inRam (buf + BitVec.ofNat 32 t + cur) 1 = true) :
    ∀ k i (e : Core), k + i = n → i < n → e.pc = 0x8001d486 → Quiet e → e.get 9 = cur →
      e.get 13 = alu .add (alu .sub 0 f) cur → e.get 12 = 0 - BitVec.ofNat 32 i →
      e.get 14 = buf + BitVec.ofNat 32 i →
      ∃ s e', QRun B img s ⟨e, M⟩ ⟨e', M⟩ ∧ e'.sameCsr e ∧
        (∀ r : Reg, r ≠ 12 → r ≠ 14 → r ≠ 15 → e'.get r = e.get r) ∧
        ((∃ j, i ≤ j ∧ j < n ∧ M (buf + BitVec.ofNat 32 j + cur) = 0 ∧ e'.pc = 0x8001d49a ∧
            e'.get 12 = 0 - BitVec.ofNat 32 j) ∨
         ((∀ t, i ≤ t → t < n → M (buf + BitVec.ofNat 32 t + cur) ≠ 0) ∧ e'.pc = 0x8001d4f8)) := by
  intro k
  induction k with
  | zero => intro i e hk hi; omega
  | succ k ih =>
    intro i e hk hi hpc hq h9 h13 h12 h14
    let a := alu .add (buf + BitVec.ofNat 32 i) cur
    let t1 := e.wr 15 a 0x8001d48a
    let t2 := t1.wr 15 (extend .b false (ramRead M a .b)) 0x8001d48e
    have q1 : Quiet t1 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) hq
    have q2 : Quiet t2 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) q1
    have s0 : DetStep B img ⟨e, M⟩ ⟨t1, M⟩ := by
      refine detStep_of (by rw [hpc]; decide) (by rw [hpc]; exact f8001d486) fun o => ?_
      rw [exec_op, h14, h9, hpc]; rfl
    have s1 : DetStep B img ⟨t1, M⟩ ⟨t2, M⟩ := by
      refine detStep_of (by show (0x8001d48a : Word).getLsbD 0 = false; decide) f8001d48a fun o => ?_
      rw [exec_load, show t1.get 15 = a by simp [t1, Core.wr_get_self], BitVec.add_zero,
        interp_load_ram (w := .b) o (show a.toNat % 1 = 0 by omega) (hin i hi)]; rfl
    have g2 : ∀ r : Reg, r ≠ 15 → t2.get r = e.get r := fun r h => by simp [t2, t1, Core.wr_get_ne, h]
    have v15 : t2.get 15 = BitVec.ofNat 32 (M a).toNat := by
      simp only [t2, Core.wr_get_self _ _ _ _ (show (15 : Reg).val ≠ 0 by decide)]; exact lbu_val M a
    by_cases hz : M a = 0
    · -- found at i
      have s2 : DetStep B img ⟨t2, M⟩ ⟨t2.goto 0x8001d49a, M⟩ := by
        refine detStep_of (by show (0x8001d48e : Word).getLsbD 0 = false; decide) f8001d48e fun o => ?_
        rw [exec_branch, v15, Core.get_zero, show BitVec.ofNat 32 (M a).toNat = 0 from (byte_zero _).mpr hz]
        simp only [taken, beq_self_eq_true, ↓reduceIte]
        rw [show t2.pc + 0xc#32 = 0x8001d49a from rfl, jump_ok _ _ (by decide)]; rfl
      refine ⟨3, t2.goto 0x8001d49a, .step hq s0 (.step q1 s1 (.single q2 s2)), ?_, ?_, .inl ⟨i, Nat.le_refl _, hi, ?_, rfl, ?_⟩⟩
      · exact (Core.sameCsr_goto _ _).trans ((Core.sameCsr_wr _ _ _ _).trans (Core.sameCsr_wr _ _ _ _))
      · intro r h12' h14' h15'; rw [Core.goto_get]; exact g2 r h15'
      · exact hz
      · rw [Core.goto_get, g2 12 (by decide)]; exact h12
    · -- not zero: a2 -= 1, a4 += 1, test
      have s2 : DetStep B img ⟨t2, M⟩ ⟨t2.goto 0x8001d490, M⟩ := by
        refine detStep_of (by show (0x8001d48e : Word).getLsbD 0 = false; decide) f8001d48e fun o => ?_
        rw [exec_branch, v15, Core.get_zero]
        have : taken .eq (BitVec.ofNat 32 (M a).toNat) 0 = false := by
          simp only [taken, beq_eq_false_iff_ne]; exact fun h => hz ((byte_zero _).mp h)
        rw [this]; rfl
      let t4 := (t2.goto 0x8001d490).wr 12 (alu .add (0 - BitVec.ofNat 32 i) 0xffffffff#32) 0x8001d492
      let t5 := t4.wr 14 (alu .add (buf + BitVec.ofNat 32 i) 0x1#32) 0x8001d494
      have q3 : Quiet (t2.goto 0x8001d490) := Quiet.of_sameCsr (Core.sameCsr_goto _ _) q2
      have q4 : Quiet t4 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) q3
      have q5 : Quiet t5 := Quiet.of_sameCsr (Core.sameCsr_wr _ _ _ _) q4
      have s3 : DetStep B img ⟨t2.goto 0x8001d490, M⟩ ⟨t4, M⟩ := by
        refine detStep_of (by show (0x8001d490 : Word).getLsbD 0 = false; decide) f8001d490 fun o => ?_
        rw [exec_opimm, Core.goto_get, g2 12 (by decide), h12]; rfl
      have s4 : DetStep B img ⟨t4, M⟩ ⟨t5, M⟩ := by
        refine detStep_of (by show (0x8001d492 : Word).getLsbD 0 = false; decide) f8001d492 fun o => ?_
        rw [exec_opimm, show t4.get 14 = e.get 14 by simp [t4, Core.wr_get_ne, g2], h14]; rfl
      have g5 : ∀ r : Reg, r ≠ 12 → r ≠ 14 → r ≠ 15 → t5.get r = e.get r := fun r a b c' => by
        simp [t5, t4, Core.wr_get_ne, a, b, g2 r c']
      have t5_12 : t5.get 12 = alu .add (0 - BitVec.ofNat 32 i) 0xffffffff#32 := by
        simp [t5, t4, Core.wr_get_ne, Core.wr_get_self]
      have t5_13 : t5.get 13 = alu .add (alu .sub 0 f) cur := by
        rw [g5 13 (by decide) (by decide) (by decide)]; exact h13
      have cs5 : t5.sameCsr e := (Core.sameCsr_wr _ _ _ _).trans ((Core.sameCsr_wr _ _ _ _).trans
        ((Core.sameCsr_goto _ _).trans ((Core.sameCsr_wr _ _ _ _).trans (Core.sameCsr_wr _ _ _ _))))
      by_cases hl : i + 1 = n
      · -- the last byte: fall out to 0x8001d4f8
        have s5 : DetStep B img ⟨t5, M⟩ ⟨t5.goto 0x8001d498, M⟩ := by
          refine detStep_of (by show (0x8001d494 : Word).getLsbD 0 = false; decide) f8001d494 fun o => ?_
          rw [exec_branch, t5_13, t5_12]
          have : taken .ne (alu .add (alu .sub 0 f) cur) (alu .add (0 - BitVec.ofNat 32 i) 0xffffffff#32) = false := by
            simp only [taken, bne_eq_false_iff_eq]; exact (scan_last f cur i n hn (by omega)).mpr hl
          rw [this]; rfl
        have q6 : Quiet (t5.goto 0x8001d498) := Quiet.of_sameCsr (Core.sameCsr_goto _ _) q5
        have s6 : DetStep B img ⟨t5.goto 0x8001d498, M⟩ ⟨t5.goto 0x8001d4f8, M⟩ := by
          refine detStep_of (by show (0x8001d498 : Word).getLsbD 0 = false; decide) f8001d498 fun o => ?_
          rw [exec_jal, Core.set_zero, show (t5.goto 0x8001d498).pc + 0x60#32 = 0x8001d4f8 from rfl,
            jump_ok _ _ (by decide)]; rfl
        refine ⟨7, t5.goto 0x8001d4f8, .step hq s0 (.step q1 s1 (.step q2 s2 (.step q3 s3 (.step q4 s4
          (.step q5 s5 (.single q6 s6)))))), (Core.sameCsr_goto _ _).trans cs5, ?_, .inr ⟨?_, rfl⟩⟩
        · intro r a b c'; rw [Core.goto_get]; exact g5 r a b c'
        · intro t ht1 ht2; have : t = i := by omega
          subst this; exact hz
      · -- more bytes: back to 0x8001d486 with i + 1
        have s5 : DetStep B img ⟨t5, M⟩ ⟨t5.goto 0x8001d486, M⟩ := by
          refine detStep_of (by show (0x8001d494 : Word).getLsbD 0 = false; decide) f8001d494 fun o => ?_
          rw [exec_branch, t5_13, t5_12]
          have : taken .ne (alu .add (alu .sub 0 f) cur) (alu .add (0 - BitVec.ofNat 32 i) 0xffffffff#32) = true := by
            simp only [taken, bne_iff_ne, ne_eq]; exact fun h => hl ((scan_last f cur i n hn (by omega)).mp h)
          rw [this]; simp only [↓reduceIte]
          rw [show t5.pc = 0x8001d494 from rfl, show (0x8001d494 : Word) + 0xfffffff2#32 = 0x8001d486 by decide,
            jump_ok _ _ (by decide)]; rfl
        have q6 : Quiet (t5.goto 0x8001d486) := Quiet.of_sameCsr (Core.sameCsr_goto _ _) q5
        obtain ⟨s', e', hr, hcs, hfr, hres⟩ := ih (i + 1) (t5.goto 0x8001d486) (by omega) (by omega) rfl q6
          (by rw [Core.goto_get, g5 9 (by decide) (by decide) (by decide)]; exact h9)
          (by rw [Core.goto_get]; exact t5_13)
          (by rw [Core.goto_get, t5_12]; exact dec_succ i)
          (by rw [Core.goto_get]; simp [t5, Core.wr_get_self]; exact inc_succ buf i)
        refine ⟨6 + s', e', (QRun.trans (.step hq s0 (.step q1 s1 (.step q2 s2 (.step q3 s3 (.step q4 s4
          (.single q5 s5)))))) hr), hcs.trans ((Core.sameCsr_goto _ _).trans cs5), ?_, ?_⟩
        · intro r a b c'; rw [hfr r a b c', Core.goto_get]; exact g5 r a b c'
        · rcases hres with ⟨j, hj1, hj2, hj3, hj4, hj5⟩ | ⟨hall, hpc'⟩
          · exact .inl ⟨j, by omega, hj2, hj3, hj4, hj5⟩
          · refine .inr ⟨fun t ht1 ht2 => ?_, hpc'⟩
            by_cases ht : t = i
            · subst ht; exact hz
            · exact hall t (by omega) ht2

end E5R.Rmk.Deframer.Next
