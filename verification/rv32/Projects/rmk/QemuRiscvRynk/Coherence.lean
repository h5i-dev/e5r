/-
  The RMK qemu-riscv-rynk image for proofs (R1). Original e5r code, Apache-2.0.

  `Image.lean` (generated by `e5r-verify ram-image`, or tools/pack_elf.py with the same packing
  rule; not committed) holds the pinned ELF (sha256 f39d833f...) as a packed `RamElf.File`.
  The image a proof runs is `RamElf.imageOf` of it, a function of the file's bytes; the board
  is QEMU virt with model RAM from the image's rwBase. The kernel checks that the reader
  accepts the file, and the facts below.
-/
import Theories.RamElf
import Theories.Chunk
import Theories.Board.QemuVirtRv32
import Projects.rmk.QemuRiscvRynk.Image

namespace Rmk.QemuRiscvRynk
open E5R

def dramSize : Nat := QemuVirtRv32.dramEnd - QemuVirtRv32.dramBase

def image : RamElf.Image := RamElf.imageOf QemuVirtRv32.dramBase dramSize elf
def img : List Segment := image.ro
def board : Board := QemuVirtRv32.board image.rwBase

/-- The image in 256-byte pieces, for proofs that fetch a lot: every model step on it is a step
    on `img` (`stepInstr_chunk`), and lookups do not walk the 135 KB code segment. -/
def imgC : List Segment := chunkImg 256 img

theorem stepInstr_imgC (m : Machine) (o : Oracle) :
    stepInstr board imgC m o = stepInstr board img m o := stepInstr_chunk 256 (by decide) board img m o

/-- The reader accepts the pinned ELF for QEMU virt's DRAM window. -/
theorem image_accepted : RamElf.accepts QemuVirtRv32.dramBase dramSize elf = true := by decide +kernel

theorem entry_eq : image.entry = 0x80000000 := by decide +kernel
theorem rwBase_eq : image.rwBase = 0x80029bc8 := by decide +kernel

/-- The instruction at the entry, fetched from the image: `lui ra, 0x80000`. -/
theorem fetch_entry : fetch img (BitVec.ofNat 32 0x80000000) = some (0x800000b7, 4) := by decide +kernel

end Rmk.QemuRiscvRynk
