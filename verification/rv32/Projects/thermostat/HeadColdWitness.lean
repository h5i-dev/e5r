  intro kind
  have casesKind : kind=0 ∨ kind=1 ∨ kind=2 ∨ kind=3 ∨ kind=4 ∨ kind=5 ∨ kind=6 ∨ kind=7 ∨ kind=8 ∨ kind=9 ∨ kind=10 ∨ kind=11 ∨ kind=12 ∨ kind=13 ∨ kind=14 ∨ kind=15 ∨ kind=16 ∨ kind=17 ∨ kind=18 ∨ kind=19 ∨ kind=20 ∨ kind=21 ∨ kind=22 ∨ kind=23 := by have := kind.isLt;omega
  rcases casesKind with h0|h1|h2|h3|h4|h5|h6|h7|h8|h9|h10|h11|h12|h13|h14|h15|h16|h17|h18|h19|h20|h21|h22|h23
  all_goals subst kind
  all_goals decide +kernel
