theorem app (kind : Fin 24) : AppState.At (ram kind) Spec.initial := by
  constructor
  all_goals try unfold Encoding.SnapshotAt
  all_goals revert kind
  all_goals decide +kernel

/-- Twenty-four satisfiable cold ELF calls with explicit independent expected
    HeadR values, complete result RAM, real main return PC, ABI and App invariant.
    These are function calls, not reset-to-UART or response-encoding claims. -/
theorem execution (kind : Fin 24) : ∃ n d after, n≤260000 ∧
    Trace.Closed B img n ⟨core kind,ram kind⟩ ⟨d,after⟩ ∧ d.pc=0x80000a26#32 ∧
      d.get 2=0x80ffeb90#32 ∧ HeadSaved.CoreAt d (core kind).get ∧
      HeadFinalResult.At after (sp+4904#32) (expected kind) ∧ AppState.At after Spec.initial := by
  have length := length_bound kind
  have cap : min (input kind).length 1024≤128 := Nat.le_trans (Nat.min_le_left _ _) length
  have clOutside : ∀ q : Fin 14, B.inRam (BitVec.ofNat 32 (0x80005de0+q.val)) 1=false := by decide +kernel
  have teOutside : ∀ q : Fin 17, B.inRam (BitVec.ofNat 32 (0x80005dee+q.val)) 1=false := by decide +kernel
  obtain ⟨n,d,after,lo,hi,trace,pc,stack,abi,result,rx,appFrame,csr⟩ := HeadColdParser.contract B (core kind) (ram kind) sp (input kind)
    rfl (by rfl) (by rfl) (by rfl) rfl (by rfl) HeadEarlyWitness.stack (by decide +kernel) (by omega)
    (max_head kind) (bytes kind) (max_body kind) clOutside teOutside
  rw [parsed kind] at result
  refine ⟨n,d,after,?_,Interrupt.close trace.det rfl,?_,stack,abi,result,appFrame rfl Spec.initial (app kind)⟩
  · unfold HeadColdComplete.budget HeadFieldsLoopComplete.budget at hi
    omega
  · change d.pc=0x80000a26#32 &&& ~~~1 at pc
    simpa only [show 0x80000a26#32 &&& ~~~1=0x80000a26#32 by decide +kernel] using pc
end E5R.Thermostat.HeadColdWitness
