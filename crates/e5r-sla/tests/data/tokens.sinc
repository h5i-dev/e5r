define endian = little;
define alignment = 1;
define space ram       type=ram_space       size=8  default;
define space register  type=register_space  size=4;
define register offset=0x0 size=8 [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 sp ];
define register offset=0x100 size=4   contextreg;
define context contextreg
  test=(0,0)
;
define token instr (16)
   op  = (8,15)
   rs  = (4,7)
   rd  = (0,3)
   imm = (0,7) signed
;
attach variables [ rs rd ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 sp ];
:nop is op=0x00 & rd=0 & rs=0 unimpl
:add rd, rs is op=0x01 & rd & rs { rd = rd + rs; }
:ldi rd, imm is op=0x02 & rd ; imm { rd = sext(imm:1); }
:jmp imm is op=0x03 & imm { local t:8 = inst_next + imm; goto [t]; }
