import NoCompiler.Ext.Rvc
import NoCompiler.Elf

/-
Export a compressed (RV64GC) binary for the extension in NoCompiler/Ext/Rvc.lean,
the way `nocompiler export` does for nocompiler binaries. Not trusted: every `instr_`
lemma is checked by `rfl` (the kernel runs `CCode.instr`), and nocompiler-audit
compares the halfwords with the ELF file.

  lake env lean --run ../examples/demo/tools/ExportC.lean ELF NAMESPACE name:addr:size...
-/
open NoCompiler

def hex (n : Nat) : String := String.ofList (Nat.toDigits 16 n)

def main (args : List String) : IO UInt32 := do
  let elf :: ns :: funcs := args | IO.eprintln "usage: ELF NAMESPACE name:addr:size..."; return 2
  let b ← IO.FS.readBinFile elf
  let .ok secs := Elf.sections b | IO.eprintln "bad ELF"; return 1
  let some t := secs.find? (·.name == ".text") | IO.eprintln "no .text"; return 1
  let halves := (List.range (t.size / 2)).map fun i =>
    BitVec.ofNat 16 ((b.get! (t.offset + 2 * i)).toNat + 256 * (b.get! (t.offset + 2 * i + 1)).toNat)
  let code : CCode := ⟨BitVec.ofNat 64 t.addr, halves.toArray⟩
  let mut out := s!"/-\nGenerated by examples/demo/tools/ExportC.lean from {elf}; do not edit.\nCompressed code: NoCompiler/Ext/Rvc.lean (an extension, not the nocompiler profile).\n-/\nimport NoCompiler.Ext.Rvc\n\nnamespace {ns}\nopen NoCompiler\n\n"
  out := out ++ s!"/-- `.text`, {halves.length} halfwords from 0x{hex t.addr}. -/\ndef code : CCode := ⟨0x{hex t.addr}#64, #[\n"
  let hs := halves.map fun h => s!"0x{hex h.toNat}#16"
  let rows := (List.range ((hs.length + 9) / 10)).map fun r => "  " ++ ", ".intercalate ((hs.drop (10 * r)).take 10)
  out := out ++ ",\n".intercalate rows ++ "]⟩\n\n"
  for f in funcs do
    let [name, a, sz] := f.splitOn ":" | IO.eprintln s!"bad function {f}"; return 2
    let some addr := (String.toNat? a) | return 2
    let some size := sz.toNat? | return 2
    let mut off := 0
    let mut n := 0
    while off < size do
      let pc := addr + off
      match code.instr (BitVec.ofNat 64 pc) with
      | some (i, len) =>
        out := out ++ s!"@[nocompiler_image] theorem instr_{hex pc} : code.instr 0x{hex pc}#64 = some ({repr i}, {len}) := by rfl\n"
        off := off + len; n := n + 1
      | none => off := off + 2
    out := out ++ s!"\n/-- `{name}`: [0x{hex addr}, 0x{hex (addr + size)}), {n} instructions. -/\ndef {name}_entry : Word := 0x{hex addr}#64\ndef {name}_size : Nat := {size}\ndef {name}_dom : Dom := [(0x{hex addr}#64, {size})]\n\n"
  out := out ++ s!"end {ns}\n"
  IO.print out
  return 0
