*.e5r-patch merge=union
*.e5r-proj  merge=union

# Preserve exact nvcc-emitted/frozen PTX bytes, including final blank lines.
demos/ptx-equivalence/original.ptx whitespace=-blank-at-eof
demos/ptx-equivalence/optimized.ptx whitespace=-blank-at-eof

# OSS artifacts are hash-bound exact compiler output, including whitespace.
demos/oss-ptx-catboost/*/*.ptx whitespace=-blank-at-eof
demos/oss-ptx-cupy-packing/*/*.ptx whitespace=-blank-at-eof
demos/oss-ptx-cupy-packing/*/original.cu whitespace=-blank-at-eol,-blank-at-eof
demos/oss-ptx-cupy-index/*/*.ptx whitespace=-blank-at-eof
demos/oss-ptx-cupy-index/*/generated.cu whitespace=-blank-at-eol,-blank-at-eof
# Keep the exact independently replayed supplied proof bytes.
demos/oss-ptx-catboost/zero_segments/equivalence.lean whitespace=-blank-at-eol
